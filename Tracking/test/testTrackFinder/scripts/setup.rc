#!/usr/bin/env bash
# Robust Key4HEP + local k4RecTracker env for batch jobs

# --- make sure nounset is OFF and no positional args are visible while sourcing ---
__saved_args=("$@")
set +u
set --   # clear $1..$9 so setup.sh won't see them

# Prefer stable stack; fall back to nightlies
if [ -f /cvmfs/sw.hsf.org/key4hep/setup.sh ]; then
  # shellcheck source=/dev/null
  source /cvmfs/sw.hsf.org/key4hep/setup.sh
else
  # shellcheck source=/dev/null
  source /cvmfs/sw-nightlies.hsf.org/key4hep/setup.sh
fi

# restore caller args and (optionally) nounset
set -- "${__saved_args[@]}"
# do NOT re-enable set -u here; keep it relaxed for the rest of the job
# set -u 2>/dev/null || true

# --- your local repo/env ---
cd /afs/cern.ch/user/c/cglenn/FCCWork/k4RecTracker

# This populates PATH/LIBRARY_PATH/PYTHONPATH etc from your local build/install
k4_local_repo

export K4RT_BUILD_DIR=/afs/cern.ch/user/c/cglenn/FCCWork/k4RecTracker/build
export K4RT_INSTALL_DIR=/afs/cern.ch/user/c/cglenn/FCCWork/k4RecTracker/install
export GENFIT_DIR=/afs/cern.ch/user/c/cglenn/FCCWork/genfit2/install

# Debug prints (helpful in condor logs)
echo "[setup.rc] $(date)"
echo "[setup.rc] python=$(command -v python3)"
echo "[setup.rc] ddsim=$(command -v ddsim || true)"
echo "[setup.rc] LD_LIBRARY_PATH length=${#LD_LIBRARY_PATH}"
