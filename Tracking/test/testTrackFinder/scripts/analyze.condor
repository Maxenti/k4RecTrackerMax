universe              = vanilla
executable            = scripts/analyze_job.sh
transfer_executable   = True
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

# ---- Resources (tune if needed) ----
request_cpus   = 2
request_memory = 8 GB
request_disk   = 6 GB

+JobFlavour = "workday"

# ---- Inputs to ship with the job ----
# Include BOTH python files + (optionally) runtime.tgz if you use it
transfer_input_files = scripts/analyze_pt_resolution_grid.py, scripts/scan_pt_time_by_event.py, runtime.tgz

# ---- Logging ----
output = logs/analyze_$(ClusterId)_$(ProcId).out
error  = logs/analyze_$(ClusterId)_$(ProcId).err
log    = logs/analyze_$(ClusterId).log

# ---- Arguments ----
# 1 inputDir 2 eosOut 3 trackColl 4 hitColl 5 qualityCut 6 minPhiSpan 7 minChordXY 8 maxCircleCond 9 centralFrac
arguments = $(INPUTDIR) $(EOSOUT) $(TRACKCOLL) $(HITCOLL) $(QCUT) $(MINPHI) $(MINCHORD) $(MAXCOND) $(CENTFRAC)

# ---- Your campaign values ----
INPUTDIR  = /eos/user/c/cglenn/reco_samples2/1_29_2026/25umCF_1.2318umAu   
# <- usually you want the BASE dir containing eta_* subdirs
# better example:
# INPUTDIR = /eos/user/c/cglenn/reco_samples2/1_18_2026/

EOSOUT    = /eos/user/c/cglenn/analyze_mat_gridscan/analyze_pt_gridscan25umCF_1.2318umAu.root

TRACKCOLL = GenFitTracks
HITCOLL   = OutputWireHitsGGTF

QCUT      = none
MINPHI    = 0.06
MINCHORD  = 500.0
MAXCOND   = 1e6
CENTFRAC  = 0.95

queue 1
