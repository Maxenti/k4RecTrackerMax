# reco.condor — one job per input ROOT file

universe        = vanilla
executable      = /afs/cern.ch/user/c/cglenn/FCCWork/k4RecTracker/Tracking/test/testTrackFinder/scripts/reco_job.sh
transfer_executable = True

# Resources / runtime window
request_cpus    = 1
request_memory  = 8 GB
request_disk    = 3 GB
+JobFlavour     = "workday"

# --- I/O under HTCondor ---
# Only ship what the job actually needs
transfer_input_files    = runtime.tgz
transfer_output_files =

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

# Logging (make sure logs/ exists before condor_submit)
# Logging MUST be on AFS/local (EOS submission not supported)
output  = /dev/null
error   = /dev/null
log     = /afs/cern.ch/user/c/cglenn/FCCWork/k4RecTracker/Tracking/test/testTrackFinder/scripts/logs/$(ClusterId).$(ProcId).log


getenv = True
stream_output = False
stream_error  = False

# --- Defaults (can be overridden by condor_submit -append "...") ---
queuefile  = scripts/filelist.txt

outdir     = /eos/user/c/cglenn/reco_samples2/1_21_2026/CFmat
compactxml = /eos/user/c/cglenn/FCCWork/GithubRepos/k4geoMax/FCCee/IDEA/compact/IDEA_o1_v03/IDEA_o1_v03CF_2umAu.xml

fitter    = genfit2
usemat    = 1
stage     = fit
fitout    = auto



# Key4hep nightly used INSIDE the job (must match runtime build ABI expectations)
k4rel = 2026-01-11
tgeofile  = /afs/cern.ch/user/c/cglenn/FCCWork/k4RecTracker/Tracking/test/testTrackFinder/IDEA_o1_v03CF.root
# Wrapper args:
#   1 infile  2 outdir  3 compact  4 fitter  5 usemat  6 stage  7 fitout  8... extraargs tokens ...  last: k4rel
#
# CRITICAL: do NOT quote $(extraargs) so it can expand to multiple argv tokens safely.
# Wrapper args:
# Pass extra flags via env; quote the value so spaces are preserved
# environment = "EXTRA_ARGS=\"$(extraargs)\""


# Arguments: fixed-position only
arguments = $(infile) $(outdir) $(compactxml) $(fitter) $(usemat) $(stage) $(fitout) $(k4rel) $(tgeofile)



queue infile from $(queuefile)
